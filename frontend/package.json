{
  "name": "wolf-materials-lab",
  "author": "DaiL workshop",
  "version": "0.1.0",
  "description": "Synthetic luxury automotive materials workshop template",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:http": "node scripts/http-check.mjs",
    "wolf:seed": "node --experimental-strip-types scripts/wolf.mjs seed",
    "wolf:reset": "node --experimental-strip-types scripts/wolf.mjs reset",
    "wolf:worker": "node --experimental-strip-types scripts/wolf.mjs worker",
    "wolf:deliver": "node --experimental-strip-types scripts/wolf.mjs deliver",
    "dev": "next dev --port 8084 --hostname 127.0.0.1",
    "start": "next start --port 8084 --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "yarn clean && yarn install && yarn dev",
    "re:build": "yarn clean && yarn install && yarn build",
    "re:build-npm": "npm run clean && npm install && npm run build",
    "tsc:dev": "yarn dev & yarn tsc:watch",
    "tsc:watch": "tsc --noEmit --watch",
    "tsc:print": "npx tsc --showConfig",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@elevenlabs/react": "^1.10.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource/barlow": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@mui/lab": "^7.0.0-beta.17",
    "@mui/material": "^7.3.2",
    "@mui/material-nextjs": "^7.3.2",
    "@mui/stylis-plugin-rtl": "^7.3.2",
    "@mui/x-data-grid": "^8.12.1",
    "@mui/x-date-pickers": "^8.12.0",
    "@mui/x-tree-view": "^8.12.0",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.12.2",
    "d3-geo": "^3.1.1",
    "dayjs": "^1.11.18",
    "es-toolkit": "^1.39.10",
    "framer-motion": "^12.23.22",
    "minimal-shared": "^1.1.0",
    "next": "^15.5.20",
    "nprogress": "^0.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "simplebar-react": "^3.3.2",
    "stylis": "^4.3.6",
    "topojson-client": "^3.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@svgr/webpack": "^8.1.0",
    "@types/autosuggest-highlight": "^3.2.3",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.5.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@types/stylis": "^4.2.7",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
