{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["cdg1"],
  "headers": [
    {"source": "/downloads/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/:path*", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}
  ]
}
