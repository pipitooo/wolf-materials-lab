# Optional host-managed OpenAI-compatible endpoint (e.g. DeepSeek).
# No provider key is required for the demo to run; the evidence engine is
# deterministic and the AI review assistant simply returns "not configured".
# WOLF_MODEL_BASE_URL=https://api.deepseek.com
# WOLF_MODEL_NAME=deepseek-chat
# WOLF_MODEL_TOKEN=your-server-side-key
